{
  "name": "indoorkit-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:venue": "pnpm --filter @indoorkit/venue-gen run generate",
    "build": "pnpm gen:venue && pnpm --filter playground run build",
    "e2e": "playwright test",
    "sdk:update": "git submodule update --remote sdk",
    "backend:up": "docker compose -f deploy/compose.yaml up -d --build --wait",
    "backend:down": "docker compose -f deploy/compose.yaml down",
    "backend:test": "vitest run --config vitest.backend.config.ts",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "dev:live": "pnpm --filter playground run dev:live"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
